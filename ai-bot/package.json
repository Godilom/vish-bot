{
  "name": "vish-ai-bot",
  "version": "0.1.0",
  "private": true,
  "description": "ВИШ AI — тонкий чат-бот в Telegram поверх Claude API (Haiku 5.5, effort low)",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",

# ВИШ AI — файл .env кладётся в /home/container/.env на сервере панели (Files → New file).
# Обязательные:
AI_BOT_TOKEN=            # токен бота ВИШ AI от @BotFather (это другой бот, не ВИШбот)
ANTHROPIC_API_KEY=       # ключ Anthropic API (console.anthropic.com → API keys)

# Необязательные — умолчания уже самые экономные:
# AI_MODEL=claude-haiku-5-5
# AI_EFFORT=low          # low | medium | high
# AI_THINKING=           # off — выключить размышление совсем (ещё дешевле, ответы проще)
# AI_MAX_TOKENS=1024     # потолок ответа вместе с размышлением
# AI_HISTORY_TURNS=3     # сколько прошлых пар «вопрос — ответ» помнить; 0 — без памяти
# AI_HISTORY_TTL_MIN=30  # через столько минут тишины разговор забывается
# AI_MAX_INPUT_CHARS=2000
# AI_DAILY_LIMIT=30      # сообщений на человека в сутки по Москве; 0 — без лимита
# AI_ALLOWED_IDS=        # id Telegram через запятую: только им (пусто — всем)
# AI_ADMIN_IDS=          # id админов: без лимита и с командой /usage
